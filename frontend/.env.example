# Address of the deployed AgentShield Intelligent Contract on GenLayer.
# Leave blank until you've deployed contract/agentshield.py — the app will
# show a clear "not configured" banner instead of failing silently.
VITE_CONTRACT_ADDRESS=

# "bradbury" (default, production-like testnet) or "studionet" (free hosted dev net)
VITE_GL_NETWORK=bradbury
